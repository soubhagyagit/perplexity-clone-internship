# NexusAI Configuration
PORT=3000
SEARXNG_URL=http://localhost:8888

# Groq API Key (Fast LLM Inference: llama-3.3-70b-versatile / llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Embeddings: text-embedding-004 / gemini-embedding-001)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: Default LLM Model Overrides
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
